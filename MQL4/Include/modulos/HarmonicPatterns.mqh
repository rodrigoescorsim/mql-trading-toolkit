class Pattern{
public:
   double minXB,maxXB,minAC,maxAC,minBD,maxBD,minXD,maxXD,minXXA,maxXXA,minXCD,maxXCD,minXAB,maxXDC,lineXB;
   string name;
   string getName() { return name; }
};

class HarmonicPatterns{
   Pattern* patterns[];
   int count;
   public:
   ~HarmonicPatterns(){
      for(int i=0; i < count; i++){
         if(patterns[i] != NULL) delete(patterns[i]);
      }
   }
   HarmonicPatterns(){
      count = patternCount;
      ArrayResize(patterns, count);   
      for(int i=0; i < count; i++){
         Pattern* pattern = new Pattern();
         pattern.minXB = pp[i][0];
         pattern.maxXB = pp[i][1];
         pattern.minAC = pp[i][2];
         pattern.maxAC = pp[i][3];
         pattern.minBD = pp[i][4];
         pattern.maxBD = pp[i][5];
         pattern.minXD = pp[i][6];
         pattern.maxXD = pp[i][7];
         pattern.minXXA = pp[i][8];
         pattern.maxXXA = pp[i][9];
         pattern.minXCD = pp[i][10];
         pattern.maxXCD = pp[i][11];
         pattern.minXAB = pp[i][12];
         pattern.maxXDC = pp[i][13];
         pattern.lineXB = pp[i][14];
         pattern.name = namepatterns[i];
         patterns[i] = pattern;
      }
   }
   Pattern* getPattern(int _pos) { return patterns[_pos]; }
   
};
   